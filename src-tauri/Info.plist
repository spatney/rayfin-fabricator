<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged over the Info.plist Tauri writes for the macOS app (tauri build reads this file from
  src-tauri). Tauri writes CFBundleDocumentTypes and UTExportedTypeDeclarations from bundle >
  fileAssociations in tauri.conf.json, but
  without document icons, so a .fabricator or .rayfin file would look like the app. These replace
  them, with the icons bundle > macOS > files puts in Contents/Resources (icons/project-file.icns,
  icons/app-file.icns). Keep the extensions and types in step with tauri.conf.json and EXTENSION
  and APP_EXTENSION in src/commands/export.rs.
-->
<plist version="1.0">
<dict>
  <!--
    The languages Fabricator comes in, so macOS shows its own parts of the app (the file dialogs,
    the standard menu items) in the user's language. Keep in step with LANGUAGES in src/i18n.rs.
  -->
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>es</string>
    <string>de</string>
    <string>ja</string>
  </array>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Fabricator project</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.rayfin.fabricator.project</string>
      </array>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>fabricator</string>
      </array>
      <key>CFBundleTypeIconFile</key>
      <string>project-file.icns</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Rayfin app</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.rayfin.fabricator.app</string>
      </array>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>rayfin</string>
      </array>
      <key>CFBundleTypeIconFile</key>
      <string>app-file.icns</string>
    </dict>
  </array>
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>com.rayfin.fabricator.project</string>
      <key>UTTypeDescription</key>
      <string>Fabricator project</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
      </array>
      <key>UTTypeIconFile</key>
      <string>project-file.icns</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>fabricator</string>
        </array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>com.rayfin.fabricator.app</string>
      <key>UTTypeDescription</key>
      <string>Rayfin app</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
      </array>
      <key>UTTypeIconFile</key>
      <string>app-file.icns</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>rayfin</string>
        </array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
