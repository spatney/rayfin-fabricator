{
  "name": "analytics",
  "description": "Power BI / semantic-model analytics dashboard (read-only): dashboard kit, DAX + Fabric data client, headless preview, and a runnable starter demo.",
  "rayfin": {
    "services": {
      "data": { "enabled": false }
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@microsoft/fabric-app-data": "1.1.0",
    "@microsoft/fabric-app-data-embed-client": "1.0.0",
    "@microsoft/fabric-app-data-proxy": "1.0.0",
    "@microsoft/rayfin-data": "^1.33.2",
    "@microsoft/rayfin-lib": "^1.33.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@graphein/node": ">=0.16.0",
    "@microsoft/fabric-app-data-cli": "1.1.0",
    "@microsoft/fabric-app-data-cli-proxy": "1.0.0",
    "@microsoft/rayfin-mcp": "^1.33.2"
  },
  "scripts": {
    "build:fabric": "npx fabric-app-data generate -o src/fabric.generated.ts && tsc -b --noCheck && vite build",
    "preview": "node scripts/preview-visual.mjs",
    "gallery": "vite"
  },
  "copy": [
    { "from": "kit/components", "to": "src/components" },
    { "from": "kit/hooks", "to": "src/hooks" },
    { "from": "kit/lib", "to": "src/lib" },
    { "from": "kit/demo", "to": "src/demo" },
    { "from": "kit/global.css", "to": "src/global.css" },
    { "from": "kit/fabric.generated.ts", "to": "src/fabric.generated.ts" },
    { "from": "kit/fabric.yaml", "to": "fabric.yaml" },
    { "from": "kit/scripts/preview-visual.mjs", "to": "scripts/preview-visual.mjs" },
    { "from": "kit/app/App.tsx", "to": "src/App.tsx", "seedReplaceIfContains": "HomePage" },
    { "from": "kit/app/main.tsx", "to": "src/main.tsx", "seedReplaceIfContains": "./main.css" }
  ],
  "next": ["build-workflow", "visuals", "dax", "headless-preview", "fabric-data", "app-design"]
}
