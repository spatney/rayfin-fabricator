{
  "name": "rayfin-fabricator",
  "version": "1.37.1",
  "description": "Fabricator — a desktop app for building Rayfin apps via chat, wrapping the GitHub Copilot CLI and the Rayfin CLI.",
  "author": "Sachin Patney (https://github.com/spatney)",
  "license": "MIT",
  "private": true,
  "homepage": "https://spatney.github.io/rayfin-fabricator/",
  "repository": {
    "type": "git",
    "url": "https://github.com/spatney/rayfin-fabricator.git"
  },
  "bugs": {
    "url": "https://github.com/spatney/rayfin-fabricator/issues"
  },
  "scripts": {
    "predev": "node scripts/rayfin-local/fetch.mjs",
    "dev": "tauri dev",
    "prebuild": "node scripts/rayfin-local/fetch.mjs",
    "build": "tauri build",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "check:build": "node scripts/check-renderer-build.mjs",
    "tauri": "tauri",
    "pretauri:dev": "node scripts/rayfin-local/fetch.mjs",
    "tauri:dev": "tauri dev",
    "pretauri:build": "node scripts/rayfin-local/fetch.mjs",
    "tauri:build": "tauri build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\"",
    "vendor:wry": "node scripts/wry/vendor-wry.mjs",
    "rayfin-local:fetch": "node scripts/rayfin-local/fetch.mjs",
    "postinstall": "node scripts/rayfin-local/fetch.mjs --optional"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@vscode/codicons": "^0.0.45",
    "highlight.js": "^11.12.0",
    "monaco-editor": "^0.57.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
